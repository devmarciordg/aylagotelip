APP_ENV=local
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173

DB_HOST=mysql
DB_PORT=3306
DB_NAME=gotelip
DB_USER=gotelip
DB_PASS=gotelip
DB_ROOT_PASS=root


# 32+ bytes. Trocar em producao.
JWT_SECRET=troque-por-um-segredo-de-32-bytes-ou-mais
SESSION_TTL=900

# Producao (Hostinger): o codigo fica fora do public_html, mas a imagem precisa
# estar dentro dele. Ex.: /home/uXXXX/domains/seudominio.com/public_html/uploads
UPLOAD_DIR=

# true em producao (HTTPS): ativa Secure nos cookies e HSTS
COOKIE_SECURE=false

SEED_ADMIN_EMAIL=admin@gotelip.local
# Obrigatorio, sem default, minimo 12 caracteres. Vazio = admin nao e semeado.
# Gerar com: php -r "echo bin2hex(random_bytes(16)), PHP_EOL;"
SEED_ADMIN_PASS=
